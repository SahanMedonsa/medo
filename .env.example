ADMIN_USERNAME=
ADMIN_EMAIL=

# Optional browser-only demo. Ignored in production.
LOCAL_DEMO=false

# Preferred public origin for canonical URLs, social previews and sitemap.
NEXT_PUBLIC_SITE_URL=https://sahanmedonsa.lk
# Optional Google Search Console HTML verification token.
GOOGLE_SITE_VERIFICATION=
