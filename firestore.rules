rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function categoryValid(value) {
      return value in ['2026 O/L Maths', 'Grade 10', 'General maths', 'AL Video Modules', 'GIT', 'O/L Courses', 'Tutes', '#tute', 'A/L Past Papers', 'O/L Past Papers'];
    }
    function medium(data) { return data.get('medium', 'si'); }
    function textValid(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.description is string && data.description.size() <= 5000
        && medium(data) in ['si', 'en'] && categoryValid(data.category) && data.created_at is string;
    }
    function validFolder(data) {
      return data.keys().hasAll(['title', 'description', 'category', 'planned_videos', 'marks', 'created_at'])
        && data.keys().hasOnly(['medium', 'title', 'description', 'category', 'planned_videos', 'marks', 'created_at'])
        && textValid(data) && data.description.size() > 0
        && data.planned_videos is int && data.planned_videos >= 1 && data.planned_videos <= 10000
        && data.marks is int && data.marks >= 0 && data.marks <= 1000;
    }
    function validVideo(data) {
      return data.keys().hasAll(['title', 'description', 'category', 'video_id', 'published', 'folder_id', 'created_at'])
        && data.keys().hasOnly(['medium', 'title', 'description', 'category', 'video_id', 'published', 'folder_id', 'created_at'])
        && textValid(data) && data.published is bool
        && data.video_id is string && data.video_id.matches('^[a-zA-Z0-9_-]{11}$')
        && (data.folder_id == null || (data.folder_id is string
          && data.folder_id.matches('^[0-9a-fA-F-]{36}$')
          && medium(get(/databases/$(database)/documents/lesson_folders/$(data.folder_id)).data) == medium(data)
          && get(/databases/$(database)/documents/lesson_folders/$(data.folder_id)).data.category == data.category));
    }
    match /pdf_folders/{id} {
      function validPdfFolder(data) {
        return data.keys().hasAll(['name', 'grade', 'medium', 'created_at'])
          && data.keys().hasOnly(['name', 'grade', 'medium', 'created_at'])
          && data.name is string && data.name.size() > 0 && data.name.size() <= 200
          && data.grade is string && data.grade.size() > 0 && data.grade.size() <= 50
          && data.medium in ['si', 'en'] && data.created_at is string;
      }
      allow read: if true;
      allow create: if admin() && validPdfFolder(request.resource.data);
      allow update: if admin() && validPdfFolder(request.resource.data)
        && request.resource.data.medium == resource.data.medium
        && request.resource.data.created_at == resource.data.created_at;
      allow delete: if false;
    }
    match /pdfs/{id} {
      function validPdf(data) {
        return data.keys().hasAll(['title', 'description', 'filename', 'size', 'published', 'created_at'])
          && data.keys().hasOnly(['title', 'description', 'filename', 'size', 'published', 'created_at', 'drive_url', 'folder_id'])
          && (!('folder_id' in data) || (data.folder_id is string
            && data.folder_id.matches('^[0-9a-fA-F-]{36}$')
            && exists(/databases/$(database)/documents/pdf_folders/$(data.folder_id))))
          && data.title is string && data.title.size() > 0 && data.title.size() <= 200
          && data.description is string && data.description.size() <= 5000
          && data.filename is string && data.filename.size() <= 200
          && data.size is int
          && (('drive_url' in data && data.drive_url is string
            && data.drive_url.matches('https://drive[.]google[.]com/file/d/[a-zA-Z0-9_-]{10,200}/view([?]resourcekey=[a-zA-Z0-9_-]{1,200})?') && data.size == 0)
            || (!('drive_url' in data) && data.size > 0 && data.size <= 3145728))
          && data.published is bool && data.created_at is string;
      }
      allow read: if resource.data.published == true || admin();
      allow create: if admin() && validPdf(request.resource.data);
      allow update: if admin() && validPdf(request.resource.data)
        && request.resource.data.created_at == resource.data.created_at;
      allow delete: if admin();
    }
    match /ranking_papers/{id} {
      function validPaper(data) {
        return data.keys().hasAll(['name', 'date', 'created_at'])
          && data.keys().hasOnly(['name', 'date', 'created_at'])
          && data.name is string && data.name.size() > 0 && data.name.size() <= 200
          && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.created_at is string;
      }
      allow read: if true;
      allow create: if admin() && validPaper(request.resource.data);
      allow update: if admin() && validPaper(request.resource.data)
        && request.resource.data.created_at == resource.data.created_at;
      allow delete: if false;
    }
    match /ranking_entries/{id} {
      function validEntry(data) {
        return data.keys().hasAll(['paper_id', 'name', 'school', 'marks', 'created_at'])
          && data.keys().hasOnly(['paper_id', 'name', 'school', 'marks', 'created_at', 'medium'])
          && medium(data) in ['si', 'en']
          && data.paper_id is string && data.paper_id.matches('^[0-9a-fA-F-]{36}$')
          && exists(/databases/$(database)/documents/ranking_papers/$(data.paper_id))
          && data.name is string && data.name.size() > 0 && data.name.size() <= 200
          && data.school is string && data.school.size() > 0 && data.school.size() <= 200
          && data.marks is number && data.marks >= 0 && data.marks <= 10000
          && data.created_at is string;
      }
      allow read: if true;
      allow create: if admin() && validEntry(request.resource.data);
      allow update: if admin() && validEntry(request.resource.data)
        && request.resource.data.paper_id == resource.data.paper_id
        && request.resource.data.created_at == resource.data.created_at;
      allow delete: if admin();
    }
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /lesson_folders/{id} {
      allow read: if true;
      allow create: if admin() && validFolder(request.resource.data);
      allow update: if admin() && validFolder(request.resource.data)
        && medium(request.resource.data) == medium(resource.data)
        && request.resource.data.category == resource.data.category
        && request.resource.data.created_at == resource.data.created_at;
      allow delete: if false;
    }
    match /modules/{id} {
      allow read: if resource.data.published == true || admin();
      allow create: if admin() && validVideo(request.resource.data);
      allow update: if admin() && validVideo(request.resource.data)
        && request.resource.data.created_at == resource.data.created_at;
      allow delete: if admin();
    }
  }
}
